FROM rust:latest

# Instalar dependencias
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Directorio de trabajo
WORKDIR /app

# Copiar solo los archivos necesarios
COPY Cargo.toml .
COPY src/ src/
COPY templates/ templates/

# Exponer puerto
EXPOSE 8000

# Compilar y ejecutar la aplicación simplificada
CMD ["sh", "-c", "cp src/main_simple.rs src/main.rs && cargo run"]
