FROM rust:latest

# Instalar dependencias
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Directorio de trabajo
WORKDIR /app

# Copiar archivos
COPY Cargo.toml .
COPY src/main_working.rs src/main.rs
COPY templates/ templates/

# Exponer puerto
EXPOSE 8000

# Compilar y ejecutar directamente
CMD ["sh", "-c", "cargo run"]
